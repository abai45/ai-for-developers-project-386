{
  "openapi": "3.1.0",
  "info": {
    "title": "Календарь звонков API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "event-types"
    }
  ],
  "paths": {
    "/api/event-types": {
      "get": {
        "operationId": "listEventTypes",
        "description": "Список типов встреч владельца в порядке ответа сервера.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventTypeView"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "event-types"
        ]
      },
      "post": {
        "operationId": "createEventType",
        "description": "Создание типа встречи владельцем; дубли названий разрешены.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventTypeView"
                }
              }
            }
          },
          "400": {
            "description": "Ответ 400 с ошибками по полям — application/problem+json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": [
          "event-types"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventType"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventType": {
        "type": "object",
        "required": [
          "name",
          "durationMinutes",
          "slotStepMinutes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Название типа встречи, 1–100 символов."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Описание типа встречи, до 500 символов; отсутствие означает пусто."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 510,
            "description": "Длительность встречи в минутах, от 1 до 510."
          },
          "slotStepMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "Шаг слотов в минутах, от 1; сервер дополнительно проверяет,\nчто шаг не превышает длительность."
          }
        },
        "description": "Тип встречи: шаблон будущей встречи, который создаёт владелец."
      },
      "EventTypeView": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор типа встречи, устанавливается сервером."
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/EventType"
          }
        ],
        "description": "Тип встречи в ответах сервера: то же, что EventType, плюс серверный идентификатор."
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Имя поля, не прошедшего проверку: name, description, durationMinutes или slotStepMinutes."
          },
          "message": {
            "type": "string",
            "description": "Понятное описание ошибки на русском — показывается прямо у поля."
          }
        },
        "description": "Ошибка валидации одного поля."
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Тип проблемы; для этого сервиса — \"about:blank\"."
          },
          "title": {
            "type": "string",
            "description": "Краткая заголовок ошибки по-русски."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-код ошибки."
          },
          "detail": {
            "type": "string",
            "description": "Человеческое описание проблемы на русском."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "Ошибки по полям — только для ответов 400."
          }
        },
        "description": "Описание ошибки по RFC 9457 (application/problem+json) — единая модель\nдля всех ошибок сервиса."
      }
    }
  }
}
