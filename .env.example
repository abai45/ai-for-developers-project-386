# Скопируйте в .env (файл в .gitignore) и экспортируйте перед запуском агента:
#   export RENDER_API_KEY=ключ из Render Dashboard → Account Settings → API Keys
# либо: set -a; source .env; set +a
#
# Ключи в git не коммитятся. OAuth-вход в Render через MCP для OpenCode пока
# не поддерживается — используется API-ключ из переменной окружения.
RENDER_API_KEY=
